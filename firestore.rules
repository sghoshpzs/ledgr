rules_version = '2';

// Each signed-in user can read and write only their own users/{uid}/... data.
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{table}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && table in ['investments', 'liabilities', 'transactions', 'items', 'history'];
    }
  }
}
