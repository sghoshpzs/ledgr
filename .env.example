# Copy to .env.local (git-ignored) and fill in from Firebase console → Project settings → Your apps → Web app.
# CI reads the same names from GitHub secrets (see .github/workflows/firebase-deploy.yml).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
